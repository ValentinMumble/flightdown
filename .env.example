# Owner mode: anyone who types this key (or opens /#owner=<key> once) reads and writes the log kept on the server.
# Any long random string, for example from `openssl rand -base64 32`.
OWNER_KEY=

# The Upstash Redis store that holds the log. Vercel adds these when you connect a store to the project
# (Storage, then Upstash for Redis). UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# `npm run seed` only: a Google Sheet shared by link holding the log to start from (the id in its address), and the
# radio's EdgeTX LOGS folder, whose logs go to the sessions of their day and model.
SEED_SHEET_ID=
SEED_LOGS_DIR=
